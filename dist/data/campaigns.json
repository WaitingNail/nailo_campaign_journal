    {
      "id": "d91bf42a-cbef-47cd-b6a3-83c96cbf06c3",
      "title": "命運之輪的轉動",
      "role": "played",
      "system": "dnd",
      "systemName": "",
      "gm": "朱朱",
      "edition": "5e",
      "cover": "./assets/campaigns/8b38097e29d141848941f9be8b85da58.webp",
